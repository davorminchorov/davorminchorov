---
// Every piece of Codyssey writing on one page. The homepage shows only the 10
// newest items; this page links each live course lesson too, so search
// engines can reach lessons from outside codyssey.dev.
import BaseLayout from '../layouts/BaseLayout.astro';
import { allWriting, formatWritingDate } from '../lib/codyssey';
import { writingPage, CODYSSEY_PROFILE_URL } from '../lib/site-content';

const { courses, groups } = await allWriting();
const isEmpty = courses.length === 0 && groups.length === 0;

const focus = 'focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1E4FD1]';
const linkArrow = `inline-flex items-center gap-2 text-[15px] font-semibold text-[#101828] underline decoration-[#101828]/25 underline-offset-[6px] transition-colors hover:decoration-[#1E4FD1] hover:text-[#1E4FD1] ${focus}`;
const itemLink = `font-body text-[17px] font-bold text-[#101828] no-underline hover:text-[#1E4FD1] ${focus}`;
const lessonLink = `font-body text-[16px] text-[#101828] no-underline hover:text-[#1E4FD1] ${focus}`;
const marker = 'font-mono text-[11px] uppercase tracking-[0.14em] text-[#5B6472]';
const label = 'font-mono text-[11px] uppercase tracking-[0.14em] text-[#1E4FD1] font-semibold';
const rule = 'border-[#E3E6EC]';
const wrap = 'max-w-[1240px] mx-auto px-5 md:px-10';
const grid = 'grid grid-cols-1 md:grid-cols-12 gap-x-6';
const h1 = 'font-body text-[clamp(30px,4.2vw,50px)] leading-[1.05] tracking-[-0.01em] font-bold text-[#101828]';
const external = { target: '_blank', rel: 'noopener noreferrer' };
---

<BaseLayout title={writingPage.title} description={writingPage.description}>
  <section class="pt-[100px] md:pt-[120px] pb-16 md:pb-24">
    <div class={wrap}>
      <div class={grid}>
        <p class={`${marker} md:col-span-2 md:pt-1 mb-6 md:mb-0`}>{writingPage.label}</p>
        <div class="md:col-span-10">
          <h1 class={h1}>{writingPage.heading}</h1>
          <p class="text-[17px] leading-relaxed text-[#5B6472] mt-5 max-w-[620px]">{writingPage.intro}</p>

          {isEmpty && <p class="text-[17px] leading-relaxed text-[#5B6472] mt-10">{writingPage.empty}</p>}

          {courses.length > 0 && (
            <section class="mt-12 md:mt-16" aria-labelledby="writing-courses">
              <h2 id="writing-courses" class={label}>{writingPage.coursesHeading}</h2>
              <ul class={`mt-4 border-t ${rule}`}>
                {courses.map((course) => (
                  <li class={`border-b ${rule} py-6`}>
                    <a href={course.href} class={`${itemLink} text-[20px]!`} {...external}>{course.title}</a>
                    <p class={`${marker} mt-2`}>
                      {course.type} · {writingPage.lessonCount(course.chapters.reduce((sum, chapter) => sum + chapter.lessons.length, 0))} · {formatWritingDate(course.date)}
                    </p>
                    {course.chapters.length > 0 && (
                      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-6 mt-6">
                        {course.chapters.map((chapter) => (
                          <div>
                            <h3 class={marker}>{chapter.title}</h3>
                            <ul class="mt-3 flex flex-col gap-2">
                              {chapter.lessons.map((lesson) => (
                                <li><a href={lesson.href} class={lessonLink} {...external}>{lesson.title}</a></li>
                              ))}
                            </ul>
                          </div>
                        ))}
                      </div>
                    )}
                  </li>
                ))}
              </ul>
            </section>
          )}

          {groups.length > 0 && (
            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10">
              {groups.map((group) => (
                <section class="mt-12 md:mt-16" aria-label={group.heading}>
                  <h2 class={label}>{group.heading}</h2>
                  <ul class={`mt-4 border-t ${rule}`}>
                    {group.items.map((item) => (
                      <li class={`border-b ${rule} py-5`}>
                        <a href={item.href} class={itemLink} {...external}>{item.title}</a>
                        <p class={`${marker} mt-2`}>{formatWritingDate(item.date)}</p>
                      </li>
                    ))}
                  </ul>
                </section>
              ))}
            </div>
          )}

          <a href={CODYSSEY_PROFILE_URL} class={`${linkArrow} mt-12`} {...external}>{writingPage.moreLinkText} <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
