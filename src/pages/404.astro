---
import BaseLayout from '../layouts/BaseLayout.astro';
import ErrorPage from '../components/ErrorPage.astro';

// Old article URLs mostly redirect to Codyssey (public/_redirects); this covers
// the ones that do not, and anyone with a mistyped link.
const courseURL = 'https://codyssey.dev/courses/building-maintainable-php-applications-foundations';
const linkClass = 'font-semibold text-[#1E4FD1] underline underline-offset-4 decoration-[#1E4FD1]/30 hover:decoration-[#1E4FD1] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1E4FD1]';
---

<BaseLayout title="Page Not Found | Davor Minchorov" description="The page you're looking for doesn't exist or has been moved.">
  <ErrorPage code={404} title="Page not found" message="The page you're looking for doesn't exist or has been moved.">
    <p slot="note">
      Looking for an article from the Building Maintainable PHP Applications series? It is now a free course on{' '}
      <a href={courseURL} class={linkClass} target="_blank" rel="noopener noreferrer">Codyssey.dev</a>.
    </p>
  </ErrorPage>
</BaseLayout>
