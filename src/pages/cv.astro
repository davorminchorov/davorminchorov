---
// A print-first CV built from the same content collections as the homepage.
// scripts/generate-cv-pdf.mjs renders this page to /davor-minchorov-cv.pdf
// after every build, so the PDF can never drift from the site.
import '../styles/global.css';
import { getCollection } from 'astro:content';
import CvRole from '../components/CvRole.astro';
import { formatMonth, sortSkillGroups, yearsOfExperience } from '../lib/career';
import { BOOKING_URL, EMAIL, services } from '../lib/site-content';

const roles = (await getCollection('experience')).sort((a, b) =>
  b.data.startDate.localeCompare(a.data.startDate),
);
const skillGroups = sortSkillGroups(await getCollection('skills'));
const talks = (await getCollection('talks')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const testimonials = (await getCollection('testimonials')).sort((a, b) => a.data.order - b.data.order);

// Client engagements through Adeva are grouped under one heading, so seven
// contracts read as one long relationship rather than seven short jobs. The
// group sits where its most recent engagement would.
const GROUP_COMPANY = 'Adeva';
const inGroup = (role: (typeof roles)[number]) => role.data.company.startsWith(GROUP_COMPANY);
const groupRoles = roles.filter(inGroup);
const group = {
  company: GROUP_COMPANY,
  startDate: groupRoles.map((role) => role.data.startDate).sort()[0],
  endDate: groupRoles.some((role) => !role.data.endDate)
    ? null
    : groupRoles.map((role) => role.data.endDate as string).sort().at(-1)!,
  roles: groupRoles,
};
type Entry = { kind: 'role'; role: (typeof roles)[number] } | { kind: 'group' };
const entries: Entry[] = [];
for (const role of roles) {
  if (!inGroup(role)) entries.push({ kind: 'role', role });
  else if (!entries.some((entry) => entry.kind === 'group')) entries.push({ kind: 'group' });
}

const languages = 'English (professional), Macedonian (native)';

const title = 'Davor Minchorov | CV | PHP Consultant & Product Engineer';
const description =
  'CV of Davor Minchorov, PHP consultant and product engineer: what I do, work experience, testimonials, skills, and talks. Available as a PDF download.';
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;

const contact = [
  { label: EMAIL, href: `mailto:${EMAIL}` },
  { label: 'davorminchorov.com', href: 'https://davorminchorov.com' },
  { label: 'linkedin.com/in/davorminchorov', href: 'https://linkedin.com/in/davorminchorov' },
  { label: 'github.com/davorminchorov', href: 'https://github.com/davorminchorov' },
  ...(BOOKING_URL ? [{ label: `Intro call: ${BOOKING_URL.replace('https://', '')}`, href: BOOKING_URL }] : []),
];

const focus = 'focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent';

const updatedOn = new Date().toLocaleDateString('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="author" content="Davor Minchorov" />
  <title>{title}</title>
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <script defer data-domain="davorminchorov.com" src="https://plausible.io/js/plausible.file-downloads.js"></script>
</head>
<body class="bg-bg-subtle print:bg-white">
  <!-- Toolbar: only on screen, never in the PDF or on paper -->
  <nav class="print:hidden sticky top-0 z-10 bg-white/95 backdrop-blur-md border-b border-border">
    <div class="max-w-[860px] mx-auto px-5 sm:px-7 h-[64px] flex items-center justify-between gap-4">
      <a href="/" class={`text-[13px] text-text-muted no-underline hover:text-text transition-colors whitespace-nowrap ${focus}`}>
        &larr; Back to site
      </a>
      <div class="flex items-center gap-4 sm:gap-6">
        <button id="print-cv" type="button" class={`text-[13px] font-semibold text-text underline decoration-text/25 underline-offset-[6px] hover:text-accent hover:decoration-accent whitespace-nowrap ${focus}`}>Print</button>
        <a href="/davor-minchorov-cv.pdf" download class={`inline-flex items-center bg-accent text-white px-4 py-2 text-[13px] font-semibold no-underline hover:bg-accent-hover whitespace-nowrap ${focus}`}>Download PDF</a>
      </div>
    </div>
  </nav>

  <main class="cv max-w-[860px] mx-auto my-8 sm:my-12 px-6 py-10 sm:px-14 sm:py-14 bg-white border border-border print:max-w-none print:m-0 print:p-0 print:border-0">
    <!-- Header -->
    <header class="border-b-2 border-accent pb-5">
      <h1 class="font-display text-[34px] leading-none font-semibold tracking-tight text-text">Davor Minchorov</h1>
      <p class="font-mono text-[11.5px] text-accent uppercase tracking-[0.14em] font-medium mt-3">
        PHP Consultant &amp; Product Engineer
      </p>
      <ul class="flex flex-wrap gap-x-4 gap-y-1 mt-3.5 text-[13px] text-text-muted list-none p-0 m-0">
        {contact.map((item) => (
          <li>
            <a href={item.href} class="text-text-muted no-underline hover:text-accent">{item.label}</a>
          </li>
        ))}
        <li>Skopje, Macedonia · Remote</li>
      </ul>
    </header>

    <!-- Summary -->
    <section class="mt-6">
      <h2 class="cv-heading">Summary</h2>
      <p class="cv-text">
        PHP consultant and product engineer, building software professionally since 2015 ({yearsOfExperience()}+ years), from small startups to Fortune 500 companies, across healthcare, fintech, iGaming, entertainment, logistics, and non-profit. I work with founders, CTOs, and product teams who have a PHP application in production and need it to keep growing without falling over. Some of the work is hands-on: new products, partner APIs, and making an existing codebase safe to change again. Some of it is leading the team: planning the work, reviewing code, and agreeing on the practices that keep the product maintainable.
      </p>
      <p class="cv-text mt-2">
        I ask what the business is trying to achieve before I write code, plan in writing, and ship with tests. I use AI coding assistants where they speed up the work. I review and test everything that ships, and I follow each client's rules on what code and data can go into outside tools. I have worked in English with clients in the US, Canada, Switzerland, Italy, Montenegro, and the UAE. I also run <a href="https://codyssey.dev" class="cv-link">Codyssey.dev</a>, where I teach engineers to build maintainable software.
      </p>
    </section>

    <!-- What I do -->
    <section class="mt-7 break-inside-avoid">
      <h2 class="cv-heading">What I Do</h2>
      <dl class="m-0 space-y-1.5">
        {services.groups.map((group) => (
          <div class="sm:grid sm:grid-cols-[180px_1fr] sm:gap-x-4">
            <dt class="text-[13px] font-semibold text-text tracking-tight">{group.title}</dt>
            <dd class="cv-text m-0">{group.summary}</dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- Experience -->
    <section class="mt-7">
      <h2 class="cv-heading">Experience</h2>
      <div class="space-y-5">
        {entries.map((entry) =>
          entry.kind === 'role' ? (
            <CvRole role={entry.role} />
          ) : (
            <div>
              <div class="cv-group-head flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-x-4">
                <h3 class="text-[15px] font-semibold tracking-tight text-accent m-0">{group.company}</h3>
                <span class="font-mono text-[11.5px] text-text-muted whitespace-nowrap">
                  {formatMonth(group.startDate)} – {formatMonth(group.endDate)}
                </span>
              </div>
              <p class="text-[12.5px] text-text-muted mt-0.5">Client engagements through {group.company}</p>
              <div class="mt-3 pl-4 border-l-2 border-border space-y-4">
                {group.roles.map((role) => (
                  <CvRole role={role} nested groupCompany={group.company} />
                ))}
              </div>
            </div>
          ),
        )}
      </div>
    </section>

    <!-- Testimonials -->
    <section class="mt-7">
      <h2 class="cv-heading">What People Say</h2>
      <div class="space-y-5">
        {testimonials.map((item) => (
          <figure class="break-inside-avoid border-l-2 border-accent pl-4">
            <blockquote class="m-0 space-y-2">
              {item.data.paragraphs.map((paragraph) => (
                <p class="cv-text">{paragraph}</p>
              ))}
            </blockquote>
            <figcaption class="text-[12.5px] text-text-muted mt-2">
              <span class="font-semibold text-text">{item.data.author}</span>, {item.data.role} · {item.data.note}
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <!-- Skills -->
    <section class="mt-7 break-inside-avoid">
      <h2 class="cv-heading">Skills</h2>
      <dl class="m-0 space-y-2">
        {skillGroups.map((group) => (
          <div class="sm:grid sm:grid-cols-[180px_1fr] sm:gap-x-4">
            <dt class="text-[13px] font-semibold text-text tracking-tight">{group.data.category}</dt>
            <dd class="cv-text m-0">{group.data.items.join(', ')}</dd>
          </div>
        ))}
        <div class="sm:grid sm:grid-cols-[180px_1fr] sm:gap-x-4">
          <dt class="text-[13px] font-semibold text-text tracking-tight">Languages</dt>
          <dd class="cv-text m-0">{languages}</dd>
        </div>
      </dl>
    </section>

    <!-- Talks & writing -->
    <section class="mt-7 break-inside-avoid">
      <h2 class="cv-heading">Talks &amp; Writing</h2>
      <ul class="m-0 p-0 list-none space-y-2">
        {talks.map((talk) => (
          <li class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-x-4">
            <span class="cv-text">
              <a href={talk.data.url} class="cv-link font-medium">{talk.data.title}</a>
              <span class="text-text-muted"> · {talk.data.type}, {talk.data.event}</span>
            </span>
            <span class="font-mono text-[11.5px] text-text-muted whitespace-nowrap">{formatMonth(talk.data.date)}</span>
          </li>
        ))}
        <li class="cv-text">
          Courses, learning paths, and articles on building maintainable PHP applications, published on{" "}
          <a href="https://codyssey.dev/author-profile/davor-minchorov" class="cv-link">Codyssey.dev</a>.
        </li>
      </ul>
    </section>

    <footer class="mt-8 pt-4 border-t border-border text-[11.5px] text-text-muted flex flex-wrap justify-between gap-2">
      <span>Updated {updatedOn}</span>
      <span>Latest version: <a href="https://davorminchorov.com/cv" class="text-text-muted no-underline hover:text-accent">davorminchorov.com/cv</a></span>
    </footer>
  </main>

  <script>
    document.getElementById('print-cv')?.addEventListener('click', () => window.print());
  </script>
</body>
</html>

<style is:global>
  @reference "../styles/global.css";

  @page {
    size: A4;
    margin: 14mm 15mm 16mm;
  }

  .cv {
    line-height: 1.5;
  }

  .cv-heading {
    @apply font-mono text-[11px] text-accent uppercase tracking-[0.14em] font-semibold mb-2.5 pb-1.5 border-b border-border;
  }

  .cv-text {
    @apply text-[13px] text-text-muted leading-relaxed;
  }

  .cv-link {
    @apply text-accent no-underline hover:underline;
  }

  @media print {
    html {
      scroll-behavior: auto;
    }

    /* A role may span two pages, but its heading stays with its first
       bullets and a single bullet never splits. */
    .cv article > div,
    .cv article > p:first-of-type,
    .cv .cv-group-head,
    .cv .cv-group-head + p,
    .cv h2 {
      break-after: avoid;
    }

    .cv li {
      break-inside: avoid;
    }

    .cv a {
      color: inherit;
    }

    .cv .cv-link,
    .cv .text-accent {
      color: #1e4fd1;
    }
  }
</style>
