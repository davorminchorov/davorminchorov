---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Expertise from '../components/Expertise.astro';
import Experience from '../components/Experience.astro';
import Skills from '../components/Skills.astro';
import Projects from '../components/Projects.astro';
import Testimonials from '../components/Testimonials.astro';
import Writing from '../components/Writing.astro';

const experience = await getCollection('experience');
const skills = await getCollection('skills');

// May be multiple concurrent current roles; pick the most recently started.
const currentRole = experience
  .filter((role) => role.data.endDate === null)
  .sort((a, b) => b.data.startDate.localeCompare(a.data.startDate))[0];

// Merge the existing high-level topics with concrete skills, deduped.
const knowsAbout = [
  ...new Set([
    'Software Engineering',
    'System Design',
    'Full-Stack Development',
    'Software Architecture',
    ...skills.flatMap((group) => group.data.items),
  ]),
];

const personJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "mainEntity": {
    "@type": "Person",
    "name": "Davor Minchorov",
    "url": "https://davorminchorov.com",
    "jobTitle": "Software Engineer",
    "description": "Software engineer partnering with startups and enterprises to design and build custom software solutions.",
    ...(currentRole && {
      "worksFor": {
        "@type": "Organization",
        "name": currentRole.data.company,
      },
    }),
    "knowsAbout": knowsAbout,
    "sameAs": [
      "https://x.com/davorminchorov",
      "https://bsky.app/profile/davorminchorov.com",
      "https://linkedin.com/in/davorminchorov",
      "https://github.com/davorminchorov"
    ]
  }
});
---

<BaseLayout>
  <script type="application/ld+json" set:html={personJsonLd} />
  <Hero />

  <About />
  <Expertise />

  <Projects />

  <Experience />

  <Testimonials />

  <Skills />

  <Writing />
</BaseLayout>
