---
// Content is fetched from Codyssey at build time and rendered statically.
// The Codyssey API only allows CORS requests from codyssey.dev, so a
// browser-side fetch from this domain is blocked. Fetching here avoids
// that entirely and gives crawlers real links. The deploy workflow runs
// on a daily schedule so newly published content shows up without a push.

const PROFILE_URL = 'https://core.codyssey.dev/api/author-profiles/davor-minchorov';

interface CodysseyItem {
  title: string;
  slug: string;
  publish_date: string;
  published: boolean;
}

interface CodysseyProfile {
  author_courses?: CodysseyItem[];
  author_insights?: CodysseyItem[];
  author_learning_paths?: CodysseyItem[];
  author_code_reviews?: CodysseyItem[];
  author_quick_tips?: CodysseyItem[];
}

interface WritingItem {
  title: string;
  date: Date;
  href: string;
  type: string;
}

const res = await fetch(PROFILE_URL, { headers: { Accept: 'application/json' } });
if (!res.ok) {
  throw new Error(`Codyssey author profile request failed: ${res.status} ${res.statusText}`);
}
const profile = ((await res.json()) as { data?: CodysseyProfile }).data ?? {};

const mapItems = (arr: CodysseyItem[] | undefined, type: string, pathPrefix: string): WritingItem[] =>
  (arr ?? [])
    .filter((item) => item.published)
    .map((item) => ({
      title: item.title,
      date: new Date(item.publish_date),
      href: `https://codyssey.dev/${pathPrefix}/${item.slug}`,
      type,
    }));

const items = [
  ...mapItems(profile.author_courses, 'Course', 'courses'),
  ...mapItems(profile.author_insights, 'Insight', 'insights'),
  ...mapItems(profile.author_learning_paths, 'Learning Path', 'learning-paths'),
  ...mapItems(profile.author_code_reviews, 'Code Review', 'code-reviews'),
  ...mapItems(profile.author_quick_tips, 'Quick Tip', 'quick-tips'),
]
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 10);

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

<section id="writing" class="py-[88px] border-t border-border">
  <div class="max-w-[1080px] mx-auto px-7">
    <span class="section-label animate">Writing</span>
    <h2 class="section-title animate delay-1">Writing</h2>
    <p class="section-desc animate delay-2">
      Articles on software development and architecture.
    </p>

    <div class="flex flex-col mt-9">
      {items.length === 0 ? (
        <p class="text-sm text-text-muted italic py-8">New content coming soon. Stay tuned.</p>
      ) : (
        items.map((item, i) => (
          <a
            href={item.href}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              'flex items-baseline justify-between gap-6 py-5 border-b border-border no-underline transition-all duration-200 hover:pl-2.5 group animate',
              i === 0 && 'border-t',
              `delay-${Math.min(i + 3, 6)}`,
            ]}
          >
            <h3 class="text-base font-medium text-text tracking-tight group-hover:text-accent transition-colors">
              {item.title}
            </h3>
            <span class="font-mono text-[11px] text-text-dim whitespace-nowrap">
              {item.type} · <time datetime={item.date.toISOString()}>{formatDate(item.date)}</time>
            </span>
          </a>
        ))
      )}
    </div>

    <a href="https://codyssey.dev/author-profile/davor-minchorov" class="arrow-link mt-7 animate delay-6" target="_blank" rel="noopener noreferrer">
      More on Codyssey.dev
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 9L9 5M9 5H5.5M9 5v3.5"/></svg>
    </a>
  </div>
</section>
