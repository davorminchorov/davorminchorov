---
// The homepage, built for the reader who gives the page 30 seconds. A summary
// panel up top answers who, what, proof and how to reach at once; a hairline
// 12-column grid carries the structure through the detail sections below it.
// The copy lives in src/lib/site-content.ts and src/content/*.json.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import portrait from '../assets/davor-minchorov.webp';
import { formatMonth, sortSkillGroups } from '../lib/career';
import { latestWriting, formatWritingDate } from '../lib/codyssey';
import {
  navLinks,
  hero,
  stats,
  about,
  services,
  work,
  howIWork,
  experience,
  skills,
  writing,
  contact,
  footer,
  CODYSSEY_URL,
  CODYSSEY_PROFILE_URL,
} from '../lib/site-content';

const allProjects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featuredProject = allProjects.find((p) => p.data.featured);
const otherProjects = allProjects.filter((p) => !p.data.featured);
const caseStudies = featuredProject ? [featuredProject, ...otherProjects] : otherProjects;

const talks = (await getCollection('talks')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const skillGroups = sortSkillGroups(await getCollection('skills'));
const roles = (await getCollection('experience')).sort((a, b) => b.data.startDate.localeCompare(a.data.startDate));
const hiddenCount = Math.max(0, roles.length - experience.visibleCount);
const writingItems = await latestWriting();

const focus = 'focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1E4FD1]';
const btnPrimary = `inline-flex items-center justify-center gap-2 bg-[#1E4FD1] text-white px-6 py-3.5 text-[15px] font-semibold no-underline transition-colors hover:bg-[#17399E] ${focus}`;
const linkArrow = `inline-flex items-center gap-2 text-[15px] font-semibold text-[#101828] underline decoration-[#101828]/25 underline-offset-[6px] transition-colors hover:decoration-[#1E4FD1] hover:text-[#1E4FD1] ${focus}`;
const navLink = `text-[13px] text-[#5B6472] no-underline transition-colors hover:text-[#101828] ${focus}`;
const marker = 'font-mono text-[11px] uppercase tracking-[0.14em] text-[#5B6472]';
const label = 'font-mono text-[11px] uppercase tracking-[0.14em] text-[#1E4FD1] font-semibold';
const rule = 'border-[#E3E6EC]';
const wrap = 'max-w-[1240px] mx-auto px-5 md:px-10';
const grid = 'grid grid-cols-1 md:grid-cols-12 gap-x-6';
const hgrid = 'grid gap-px bg-[#E3E6EC] border border-[#E3E6EC]';
const cell = 'bg-white';
const h2 = 'font-body text-[clamp(30px,4.2vw,50px)] leading-[1.05] tracking-[-0.01em] font-bold text-[#101828]';
const tag = 'inline-flex items-center px-2.5 py-1 border border-[#E3E6EC] font-mono text-[11px] text-[#5B6472]';

const navItems = navLinks.map((item) => ({ label: item.label, href: `#${item.section}` }));
---

<div class="bg-white text-[#101828] font-body antialiased">
  <!-- Header -->
  <header class={`fixed top-0 inset-x-0 z-50 bg-white/95 backdrop-blur-md border-b ${rule}`}>
    <div class={`${wrap} h-[64px] flex items-center justify-between`}>
      <a href="#top" class={`flex items-baseline gap-2.5 no-underline text-[#101828] ${focus}`}>
        <span class="font-body text-[17px] font-bold tracking-tight whitespace-nowrap">Davor Minchorov</span>
        <span class="hidden xl:inline font-mono text-[10px] uppercase tracking-[0.14em] text-[#5B6472]">{hero.eyebrow}</span>
      </a>

      <nav class="hidden lg:flex items-center gap-5 xl:gap-6" aria-label="Main">
        {navItems.map((item) => (
          <a href={item.href} class={`${navLink} whitespace-nowrap`}>{item.label}</a>
        ))}
        <a href="#contact" class={`${btnPrimary} whitespace-nowrap px-4! py-2! text-[13px]!`}>{hero.ctas.primary.label}</a>
      </nav>

      <details class="lg:hidden relative group">
        <summary class={`list-none [&::-webkit-details-marker]:hidden cursor-pointer font-mono text-[11px] uppercase tracking-[0.14em] text-[#101828] border ${rule} px-3 py-2 ${focus}`}>
          <span class="group-open:hidden">Menu</span>
          <span class="hidden group-open:inline">Close</span>
        </summary>
        <nav class={`absolute right-0 top-[calc(100%+12px)] w-[240px] bg-white border ${rule} shadow-[0_16px_32px_rgba(16,24,40,0.12)] p-5 flex flex-col gap-4`} aria-label="Main">
          {navItems.map((item) => (
            <a href={item.href} class={`${navLink} text-[16px]! text-[#101828]!`}>{item.label}</a>
          ))}
          <a href="#contact" class={`${btnPrimary} mt-1`}>{hero.ctas.primary.label}</a>
        </nav>
      </details>
    </div>
  </header>

  <!-- Summary panel (the 30-second read) -->
  <section id="top" class="pt-[100px] md:pt-[120px] pb-16 md:pb-24 scroll-mt-[64px]">
    <div class={wrap}>
      <p class={`${marker} mb-4`}>01 / Summary</p>

      <div class={`${hgrid} grid-cols-1 md:grid-cols-12`}>
        <div class={`${cell} p-6 md:p-8 md:col-span-5 flex items-center gap-5`}>
          <Image
            src={portrait}
            alt="Davor Minchorov"
            widths={[96, 144, 192]}
            sizes="96px"
            class="w-20 h-20 md:w-24 md:h-24 rounded-full object-cover shrink-0 ring-1 ring-[#E3E6EC]"
            loading="eager"
            decoding="async"
          />
          <div>
            <p class="font-body text-[20px] md:text-[22px] font-bold leading-tight text-[#101828]">Davor Minchorov</p>
            <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-[#5B6472] mt-2">{hero.eyebrow}</p>
          </div>
        </div>

        <div class={`${cell} p-6 md:p-8 md:col-span-7`}>
          <h1 class="font-display text-[clamp(26px,3.4vw,38px)] leading-[1.15] tracking-[-0.01em] font-semibold text-[#101828]">{hero.headline}</h1>
          <p class="text-[15px] md:text-[16px] leading-relaxed text-[#5B6472] mt-4">{hero.intro}</p>
          <p class="text-[15px] leading-relaxed text-[#5B6472] mt-3">
            {hero.codyssey.before}<a href={CODYSSEY_URL} class={`font-semibold text-[#1E4FD1] underline underline-offset-4 decoration-[#1E4FD1]/30 hover:decoration-[#1E4FD1] ${focus}`} target="_blank" rel="noopener noreferrer">{hero.codyssey.linkText}</a>{hero.codyssey.after}
          </p>
        </div>

        <div class={`${cell} p-6 md:p-8 md:col-span-5`}>
          <div class="grid grid-cols-3 md:grid-cols-1 lg:grid-cols-3 gap-6 md:gap-5 lg:gap-6">
            {stats.map((stat) => (
              <div>
                <p class="font-body text-[26px] md:text-[30px] font-bold leading-none text-[#101828]">{stat.value}</p>
                <p class={`${marker} mt-2`}>{stat.label}</p>
              </div>
            ))}
          </div>
        </div>

        <div class={`${cell} p-6 md:p-8 md:col-span-7 order-2 md:order-none`}>
          <p class={label}>{services.title}</p>
          <ul class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-3">
            {services.items.map((item) => (
              <li class="text-[15px] leading-snug text-[#101828] font-medium">{item.title}</li>
            ))}
          </ul>
        </div>

        <div class={`${cell} p-6 md:p-8 md:col-span-12 order-3 md:order-none`}>
          <p class={label}>{work.title}</p>
          <ul class="mt-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-4">
            {caseStudies.map((project) => (
              <li>
                <a href={`#project-${project.id}`} class={`block text-[15px] leading-snug font-medium text-[#101828] no-underline hover:text-[#1E4FD1] ${focus}`}>{project.data.title}</a>
                <p class="font-mono text-[11px] uppercase tracking-[0.1em] text-[#5B6472] mt-0.5">{project.data.industry}{project.data.country && ` · ${project.data.country}`}</p>
              </li>
            ))}
          </ul>
        </div>

        <div class="p-6 md:p-8 md:col-span-12 order-1 md:order-none bg-[#F7F8FA] flex flex-wrap items-center gap-x-8 gap-y-4">
          <a href="#contact" class={btnPrimary}>{hero.ctas.primary.label}</a>
          <a href="#projects" class={linkArrow}>{hero.ctas.secondary.label}</a>
          <a href={hero.ctas.cv.href} download class={linkArrow}>{hero.ctas.cv.label} <span aria-hidden="true">↓</span></a>
          <a href={contact.primary.href} class={linkArrow}>{contact.primary.label}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" class={`border-t ${rule} py-16 md:py-24 scroll-mt-[64px]`}>
    <div class={`${wrap} ${grid}`}>
      <p class={`${marker} md:col-span-2 md:pt-1 mb-6 md:mb-0`}>02 / {about.label}</p>
      <div class="md:col-span-8">
        <h2 class={h2}>{about.title}</h2>
        {about.paragraphs.map((p) => (
          <p class="text-[16px] md:text-[17px] leading-relaxed text-[#101828] mt-6">{p}</p>
        ))}
      </div>
    </div>
  </section>

  <!-- Services -->
  <section id="services" class={`border-t ${rule} py-16 md:py-24 scroll-mt-[64px]`}>
    <div class={wrap}>
      <div class={grid}>
        <p class={`${marker} md:col-span-2 md:pt-1 mb-6 md:mb-0`}>03 / {services.label}</p>
        <div class="md:col-span-10">
          <h2 class={h2}>{services.title}</h2>
          <p class="text-[17px] leading-relaxed text-[#5B6472] mt-5 max-w-[560px]">{services.desc}</p>
        </div>
      </div>

      <div class={`${hgrid} grid-cols-1 sm:grid-cols-2 mt-10 md:mt-14`}>
        {services.items.map((item) => (
          <div class={`${cell} p-7 md:p-9`}>
            <p class="font-mono text-[12px] text-[#1E4FD1]">{item.num}</p>
            <h3 class="font-body text-[21px] md:text-[23px] font-bold leading-snug text-[#101828] mt-3">{item.title}</h3>
            <p class="text-[15px] leading-relaxed text-[#5B6472] mt-3">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Case studies -->
  <section id="projects" class={`border-t ${rule} py-16 md:py-24 scroll-mt-[64px]`}>
    <div class={wrap}>
      <div class={grid}>
        <p class={`${marker} md:col-span-2 md:pt-1 mb-6 md:mb-0`}>04 / {work.label}</p>
        <div class="md:col-span-10">
          <h2 class={h2}>{work.title}</h2>
          <p class="text-[17px] leading-relaxed text-[#5B6472] mt-5 max-w-[560px]">{work.desc}</p>
        </div>
      </div>

      <div class="mt-10 md:mt-14 flex flex-col gap-8 md:gap-10">
        {caseStudies.map((project) => (
          <article id={`project-${project.id}`} class={`border ${rule} scroll-mt-[64px]`}>
            <div class={`p-6 md:p-8 border-b ${rule} flex flex-col md:flex-row md:items-start md:justify-between gap-4`}>
              <div>
                {project.data.featured && (
                  <p class="inline-flex items-center bg-[#1E4FD1]/10 text-[#1E4FD1] px-2.5 py-1 font-mono text-[11px] uppercase tracking-[0.12em] mb-3">{work.featuredBadge}</p>
                )}
                <p class={marker}>{project.data.industry}{project.data.country && ` · ${project.data.country}`}</p>
                <h3 class="font-body text-[24px] md:text-[27px] font-bold leading-tight text-[#101828] mt-2">{project.data.title}</h3>
                <div class="flex flex-wrap gap-2 mt-4">
                  {project.data.stack.map((item) => (
                    <span class={tag}>{item}</span>
                  ))}
                </div>
              </div>
              {project.data.url && (
                <a href={project.data.url} class={`${linkArrow} md:shrink-0`} target="_blank" rel="noopener noreferrer">
                  {project.data.featured ? work.featuredLinkText : work.linkText} <span aria-hidden="true">→</span>
                </a>
              )}
            </div>

            <div class={`${hgrid} grid-cols-1 md:grid-cols-2`}>
              <div class={`${cell} p-6 md:p-8`}>
                <p class={label}>{work.parts.problem}</p>
                <p class="text-[15px] leading-relaxed text-[#101828] mt-2">{project.data.problem}</p>
              </div>
              <div class={`${cell} p-6 md:p-8`}>
                <p class={label}>{work.parts.why}</p>
                <p class="text-[15px] leading-relaxed text-[#101828] mt-2">{project.data.why}</p>
              </div>
              <div class={`${cell} p-6 md:p-8`}>
                <p class={label}>{work.parts.did}</p>
                <ul class="mt-2 space-y-2">
                  {project.data.did.map((item) => (
                    <li class="text-[15px] leading-relaxed text-[#101828] grid grid-cols-[16px_minmax(0,1fr)]">
                      <span class="text-[#1E4FD1]" aria-hidden="true">+</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
              {project.data.result && (
                <div class={`${cell} p-6 md:p-8`}>
                  <p class={label}>{work.parts.result}</p>
                  <p class="text-[15px] leading-relaxed text-[#101828] mt-2">{project.data.result}</p>
                </div>
              )}
            </div>

            {project.data.quote && (
              <blockquote class={`p-6 md:p-8 border-t ${rule} border-l-4 border-l-[#1E4FD1]`}>
                <p class="text-[18px] md:text-[19px] italic font-medium leading-[1.5] text-[#101828]">{project.data.quote.text}</p>
                <footer class={`${marker} mt-3`}>{project.data.quote.author} · {project.data.quote.role}</footer>
              </blockquote>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- How I work -->
  <section id="how-i-work" class={`border-t ${rule} py-16 md:py-24 scroll-mt-[64px]`}>
    <div class={wrap}>
      <div class={grid}>
        <p class={`${marker} md:col-span-2 md:pt-1 mb-6 md:mb-0`}>05 / {howIWork.label}</p>
        <div class="md:col-span-10">
          <h2 class={h2}>{howIWork.title}</h2>
        </div>
      </div>

      <div class={`${hgrid} grid-cols-1 md:grid-cols-2 mt-10 md:mt-14`}>
        {howIWork.points.map((point, i) => (
          <div class={`${cell} p-6 md:p-8 flex gap-4`}>
            <span class="font-mono text-[12px] text-[#1E4FD1] pt-1">{String(i + 1).padStart(2, '0')}</span>
            <p class="text-[16px] md:text-[17px] leading-[1.5] text-[#101828]">{point}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section id="experience" class={`border-t ${rule} py-16 md:py-24 scroll-mt-[64px]`}>
    <div class={wrap}>
      <div class={grid}>
        <p class={`${marker} md:col-span-2 md:pt-1 mb-6 md:mb-0`}>06 / {experience.label}</p>
        <div class="md:col-span-10">
          <h2 class={h2}>{experience.title}</h2>
          <p class="text-[17px] leading-relaxed text-[#5B6472] mt-5 max-w-[560px]">{experience.desc}</p>
        </div>
      </div>

      <div class="flex flex-col gap-px bg-[#E3E6EC] border border-[#E3E6EC] mt-10 md:mt-14">
        {roles.map((role, i) => (
          <article class:list={[cell, 'p-6 md:p-8', i >= experience.visibleCount && 'experience-extra hidden']}>
            <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
              <h3 class="font-body text-[20px] md:text-[22px] font-bold leading-tight text-[#101828]">{role.data.title}</h3>
              <span class={`${marker} whitespace-nowrap`}>{formatMonth(role.data.startDate)} – {formatMonth(role.data.endDate)}</span>
            </div>
            <p class="text-[15px] font-semibold text-[#1E4FD1] mt-1.5">{role.data.company}</p>
            <p class="text-[13px] text-[#5B6472] mt-1">
              {role.data.industry}
              {role.data.clientLocation && <span> · Client: {role.data.clientLocation}</span>}
              {role.data.location && <span> · {role.data.location}</span>}
            </p>
            <ul class="mt-4 space-y-2">
              {role.data.outcomes.map((outcome) => (
                <li class="text-[15px] leading-relaxed text-[#101828] grid grid-cols-[16px_minmax(0,1fr)]">
                  <span class="text-[#1E4FD1]" aria-hidden="true">+</span>
                  <span>{outcome}</span>
                </li>
              ))}
            </ul>
            {role.data.skills.length > 0 && (
              <div class="flex flex-wrap gap-2 mt-4">
                {role.data.skills.map((skill) => (
                  <span class={tag}>{skill}</span>
                ))}
              </div>
            )}
          </article>
        ))}
      </div>

      {hiddenCount > 0 && (
        <button id="experience-toggle" class={`${linkArrow} mt-8 bg-transparent border-none cursor-pointer p-0!`}>
          {experience.showAllLabel(hiddenCount)}
        </button>
      )}
    </div>
  </section>

  <!-- Skills -->
  <section id="skills" class={`border-t ${rule} py-16 md:py-24 scroll-mt-[64px]`}>
    <div class={wrap}>
      <div class={grid}>
        <p class={`${marker} md:col-span-2 md:pt-1 mb-6 md:mb-0`}>07 / {skills.label}</p>
        <div class="md:col-span-10">
          <h2 class={h2}>{skills.title}</h2>
          <p class="text-[17px] leading-relaxed text-[#5B6472] mt-5 max-w-[560px]">{skills.desc}</p>

          <div class="mt-10 md:mt-14 space-y-8">
            {skillGroups.map((group) => (
              <div class={`border-t ${rule} pt-6`}>
                <h3 class={label}>{group.data.category}</h3>
                <div class="flex flex-wrap gap-2 mt-4">
                  {group.data.items.map((item) => (
                    <span class={tag}>{item}</span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Talks & writing -->
  <section id="writing" class={`border-t ${rule} py-16 md:py-24 scroll-mt-[64px]`}>
    <div class={wrap}>
      <div class={grid}>
        <p class={`${marker} md:col-span-2 md:pt-1 mb-6 md:mb-0`}>08 / {writing.label}</p>
        <div class="md:col-span-10">
          <h2 class={h2}>{writing.title}</h2>
          <p class="text-[17px] leading-relaxed text-[#5B6472] mt-5 max-w-[560px]">{writing.desc}</p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 mt-10 md:mt-14">
            <div>
              <h3 class={label}>{writing.talksHeading}</h3>
              <ul class={`mt-4 border-t ${rule}`}>
                {talks.map((talk) => (
                  <li class={`border-b ${rule} py-5`}>
                    <a href={talk.data.url} class={`font-body text-[17px] font-bold text-[#101828] no-underline hover:text-[#1E4FD1] ${focus}`} target="_blank" rel="noopener noreferrer">{talk.data.title}</a>
                    <p class={`${marker} mt-2`}>{talk.data.type} · {talk.data.event} · {formatMonth(talk.data.date)}</p>
                  </li>
                ))}
              </ul>
            </div>
            <div class="mt-8 md:mt-0">
              <h3 class={label}>{writing.writingHeading}</h3>
              {writingItems.length === 0 ? (
                <p class="text-[16px] text-[#5B6472] mt-4">{writing.empty}</p>
              ) : (
                <ul class={`mt-4 border-t ${rule}`}>
                  {writingItems.map((item) => (
                    <li class={`border-b ${rule} py-5`}>
                      <a href={item.href} class={`font-body text-[17px] font-bold text-[#101828] no-underline hover:text-[#1E4FD1] ${focus}`} target="_blank" rel="noopener noreferrer">{item.title}</a>
                      <p class={`${marker} mt-2`}>{item.type} · {formatWritingDate(item.date)}</p>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>

          <a href={CODYSSEY_PROFILE_URL} class={`${linkArrow} mt-8`} target="_blank" rel="noopener noreferrer">{writing.moreLinkText} <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class={`border-t ${rule} py-16 md:py-24 scroll-mt-[64px]`}>
    <div class={wrap}>
      <div class={grid}>
        <p class={`${marker} md:col-span-2 md:pt-1 mb-6 md:mb-0`}>09 / {contact.label}</p>
        <div class="md:col-span-10">
          <h2 class={h2}>{contact.title}</h2>
          <p class="text-[17px] md:text-[18px] leading-relaxed text-[#101828] mt-6 max-w-[720px]">{contact.desc}</p>
          <p class={`${marker} mt-4`}>{contact.availability}</p>

          <div class="mt-8">
            <a href={contact.primary.href} class={btnPrimary}>{contact.primary.label}</a>
          </div>

          <div class="flex flex-wrap items-center gap-x-8 gap-y-4 mt-8">
            {contact.links.map((link) => (
              <a href={link.href} class={linkArrow} target="_blank" rel="noopener noreferrer">{link.label} <span aria-hidden="true">→</span></a>
            ))}
            <a href={contact.cv.href} download class={linkArrow}>{contact.cv.label} <span aria-hidden="true">↓</span></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class={`border-t ${rule} py-8`}>
    <div class={`${wrap} flex flex-col md:flex-row md:items-center md:justify-between gap-4`}>
      <p class="text-[13px] text-[#5B6472]">{footer.copyright}</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {footer.links.map((link) => (
          <li>
            <a href={link.href} class={`text-[13px] text-[#5B6472] no-underline hover:text-[#101828] ${focus}`} target="_blank" rel="noopener noreferrer">{link.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </footer>
</div>

<script>
  // The mobile menu is a <details> element; close it once a link is chosen.
  document.querySelectorAll<HTMLAnchorElement>('header details a').forEach((link) => {
    link.addEventListener('click', () => link.closest('details')?.removeAttribute('open'));
  });

  const toggle = document.getElementById('experience-toggle');
  toggle?.addEventListener('click', () => {
    document.querySelectorAll('.experience-extra').forEach((el) => el.classList.remove('hidden'));
    toggle.remove();
  });
</script>
