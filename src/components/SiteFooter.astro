---
// The site footer, shared by the homepage and the error pages.
import { footer } from '../lib/site-content';

const focus = 'focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1E4FD1]';
const wrap = 'max-w-[1240px] mx-auto px-5 md:px-10';
---

<footer class="border-t border-[#E3E6EC] py-8">
  <div class={`${wrap} flex flex-col md:flex-row md:items-center md:justify-between gap-4`}>
    <p class="text-[13px] text-[#5B6472]">{footer.copyright}</p>
    <ul class="flex flex-wrap gap-x-6 gap-y-2">
      {footer.links.map((link) => (
        <li>
          <a href={link.href} class={`text-[13px] text-[#5B6472] no-underline hover:text-[#101828] ${focus}`} target="_blank" rel="noopener noreferrer">{link.label}</a>
        </li>
      ))}
    </ul>
  </div>
</footer>
