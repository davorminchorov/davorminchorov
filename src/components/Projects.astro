---
import { getCollection } from 'astro:content';
import FeaturedProject from './FeaturedProject.astro';
import ProjectCard from './ProjectCard.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const featured = projects.find((p) => p.data.featured);
const rest = projects.filter((p) => p !== featured);
---

<section id="projects" class="py-[88px]">
  <div class="max-w-[1080px] mx-auto px-7">
    <span class="section-label animate">Selected Work</span>
    <h2 class="section-title animate delay-1">Case Studies</h2>
    <p class="section-desc animate delay-2">
      Client names left out. Industry, country, and what changed are what matter.
    </p>

    {featured && <FeaturedProject project={featured.data} />}

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-5">
      {rest.map((p, i) => (
        <ProjectCard project={p.data} animationDelay={`delay-${Math.min(i + 3, 6)}`} />
      ))}
    </div>
  </div>
</section>
