---
import { getCollection } from 'astro:content';
import { sortSkillGroups } from '../lib/career';

const groups = sortSkillGroups(await getCollection('skills'));
---

<section id="skills" class="py-[88px] border-t border-border">
  <div class="max-w-[1080px] mx-auto px-7">
    <span class="section-label animate">Skills</span>
    <h2 class="section-title animate delay-1">Tools & Technologies</h2>
    <p class="section-desc animate delay-2">
      The tools I use most, and the ones I am comfortable working in.
    </p>

    <div class="mt-9 space-y-7">
      {groups.map((group, i) => (
        <div class={`animate delay-${Math.min(i + 3, 6)}`}>
          <h3 class="text-[13px] font-semibold uppercase tracking-wide text-text-muted">
            {group.data.category}
          </h3>
          <div class="flex flex-wrap gap-2 mt-3">
            {group.data.items.map((item) => (
              <span class="inline-flex items-center px-3 py-1 rounded-full border border-border bg-bg-card text-[13px] text-text-secondary">
                {item}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
