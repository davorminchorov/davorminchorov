---
const profiles = [
  { label: 'Hire me on Upwork', href: 'https://www.upwork.com/freelancers/~01284b0e7aa5b9f5a9', style: 'btn-primary' },
  { label: 'Hire me on Toptal', href: 'https://www.toptal.com/developers/resume/davor-minchorov', style: 'btn-secondary' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/davorminchorov', style: 'arrow-link' },
  { label: 'GitHub', href: 'https://github.com/davorminchorov', style: 'arrow-link' },
];
---

<section id="contact" class="py-[88px] border-t border-border">
  <div class="max-w-[1080px] mx-auto px-7">
    <span class="section-label animate">Contact</span>
    <h2 class="section-title animate delay-1">Work with me</h2>
    <p class="section-desc animate delay-2">
      If you have a PHP application that needs new features, a better architecture, or a rescue, send me a short note about what you are working on. I reply within a day.
    </p>

    <div class="flex flex-wrap items-center gap-x-6 gap-y-3 mt-8 animate delay-3">
      {profiles.map((profile) => (
        <a href={profile.href} class={profile.style} target="_blank" rel="noopener noreferrer">
          {profile.label}
          {profile.style === 'arrow-link' && (
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 9L9 5M9 5H5.5M9 5v3.5"/></svg>
          )}
        </a>
      ))}
    </div>
  </div>
</section>
