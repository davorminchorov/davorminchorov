---
const items = [
  {
    num: '01',
    title: 'API and backend development',
    desc: 'REST and GraphQL APIs in PHP (Laravel, Symfony). Built for teams that need the backend to be reliable and easy to extend.',
  },
  {
    num: '02',
    title: 'System architecture',
    desc: 'Designing the structure of an application so it holds up as the team and the requirements grow. Vertical slices, clear boundaries, domain-driven design where it earns its place.',
  },
  {
    num: '03',
    title: 'Refactoring and modernising existing PHP codebases',
    desc: 'Making an existing codebase safe to change again. Adding tests, refactoring in stages, and modernising while the app stays live and features keep shipping.',
  },
  {
    num: '04',
    title: 'Performance and integrations',
    desc: 'Search, caching, and database work on high-traffic systems. Third-party integrations including payments, blockchain, and Web3.',
  },
];
---

<section id="services" class="py-[88px] border-t border-border">
  <div class="max-w-[1080px] mx-auto px-7">
    <span class="section-label animate">Services</span>
    <h2 class="section-title animate delay-1">What I Do</h2>
    <p class="section-desc animate delay-2">
      Product engineering for teams that need their PHP application to keep working as it grows.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mt-9">
      {items.map((item, i) => (
        <div class={`p-8 border border-border rounded-[10px] bg-bg-card shadow-sm animate delay-${i + 3}`}>
          <div class="font-display text-[26px] font-bold text-accent mb-3.5 leading-none">{item.num}</div>
          <h3 class="text-[15px] font-semibold mb-2 tracking-tight">{item.title}</h3>
          <p class="text-sm text-text-secondary leading-relaxed">{item.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
