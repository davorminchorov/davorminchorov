---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>['data'];
}

const { project } = Astro.props;
---

<div class="border border-border rounded-xl p-12 bg-bg-card shadow-sm relative overflow-hidden transition-all duration-300 hover:border-border-hover hover:shadow-md mt-12 animate delay-2">
  <!-- Top accent bar -->
  <div class="absolute top-0 left-0 right-0 h-[3px] bg-accent"></div>

  <div class="font-mono text-[11px] text-accent uppercase tracking-widest bg-accent-light px-3.5 py-1 rounded-full inline-block mb-5 font-medium">
    Own product
  </div>
  <h3 class="font-display text-[clamp(26px,3vw,34px)] leading-tight font-bold tracking-tight mb-3.5">
    {project.title}
  </h3>

  <div class="max-w-[640px] space-y-4">
    <div>
      <p class="font-mono text-[11px] text-accent uppercase tracking-widest font-medium mb-1">Problem</p>
      <p class="text-base text-text-secondary leading-relaxed">{project.problem}</p>
    </div>

    <div>
      <p class="font-mono text-[11px] text-accent uppercase tracking-widest font-medium mb-1">What I did</p>
      <ul class="space-y-2">
        {project.did.map((item) => (
          <li class="text-base text-text-secondary leading-relaxed flex gap-2.5">
            <span class="text-accent mt-2 flex-shrink-0 w-1 h-1 rounded-full bg-accent" aria-hidden="true"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>

    {project.result && (
      <div>
        <p class="font-mono text-[11px] text-accent uppercase tracking-widest font-medium mb-1">Result</p>
        <p class="text-base text-text-secondary leading-relaxed">{project.result}</p>
      </div>

    )}
  </div>

  <div class="flex flex-wrap gap-2 mt-6">
    {project.stack.map((item) => (
      <span class="tag">{item}</span>
    ))}
  </div>

  {project.url && (
    <a href={project.url} class="arrow-link mt-8" target="_blank" rel="noopener noreferrer">
      Visit Codyssey.dev
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 9L9 5M9 5H5.5M9 5v3.5"/></svg>
    </a>
  )}
</div>
