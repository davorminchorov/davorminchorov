---
import { Image } from 'astro:assets';
import portrait from '../assets/davor-minchorov.webp';
import { yearsOfExperience } from '../lib/career';

interface StatItem {
  value: string;
  label: string;
}

const stats: StatItem[] = [
  { value: `${yearsOfExperience()}+`, label: 'Years Experience' },
  { value: '10+', label: 'Industries' },
  { value: '6', label: 'Client Countries' },
];
---

<header class="hero pt-[148px] pb-[88px] border-b border-border">
  <div class="max-w-[1080px] mx-auto px-7">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-12">
      <div class="flex-1 min-w-0">
        <div class="font-mono text-xs text-accent uppercase tracking-wider font-medium mb-5 animate">
          Product Software Engineer · PHP
        </div>
        <h1 class="font-display text-[clamp(36px,5vw,58px)] leading-[1.12] tracking-tight text-text mb-6 max-w-[680px] font-bold animate delay-1">
          I build PHP products that have to keep working for years.
        </h1>
        <p class="text-[17px] text-text-secondary max-w-[540px] leading-relaxed animate delay-2">
          I work with founders and product teams on APIs, architecture, and modernising existing codebases. I care about what the software is for, not just whether it compiles.
        </p>
        <p class="text-[17px] text-text-secondary max-w-[540px] leading-relaxed animate delay-2 mt-2">
          I also run <a href="https://codyssey.dev" class="text-accent font-medium no-underline hover:underline" target="_blank" rel="noopener noreferrer">Codyssey.dev</a>, where I teach engineers to build maintainable software.
        </p>
        <div class="flex flex-wrap gap-3 mt-8 animate delay-3">
          <a href="#contact" class="btn-primary">Work with me</a>
          <a href="#projects" class="btn-secondary">See my work</a>
          <a href="/davor-minchorov-cv.pdf" download class="btn-secondary">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 2v7M4 6.5L7 9.5 10 6.5M2.5 11.5h9"/></svg>
            Download CV
          </a>
        </div>
      </div>
      <div class="shrink-0 animate delay-2">
        <Image
          src={portrait}
          alt="Davor Minchorov"
          widths={[220, 280, 440, 560]}
          sizes="(min-width: 768px) 280px, 220px"
          class="w-[220px] h-[220px] md:w-[280px] md:h-[280px] rounded-2xl object-cover object-[center_20%] shadow-lg"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>
    </div>
    <div class="flex flex-wrap gap-x-8 gap-y-6 sm:gap-14 mt-12 pt-8 border-t border-border animate delay-3">
      {stats.map((stat) => (
        <div>
          <div class="font-display text-[28px] font-bold text-text leading-none">{stat.value}</div>
          <div class="text-[13px] text-text-muted mt-1.5 tracking-wide">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>
</header>
