---
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  // The page renders its own nav and footer (the homepage does).
  bare?: boolean;
}

const {
  title = 'Davor Minchorov | Product Software Engineer (PHP)',
  description = 'Product software engineer working in PHP. I help founders and product teams build APIs, design architecture, and modernise existing codebases, with an eye on what the product is for.',
  image = '/og-image.jpg',
  imageAlt = 'Davor Minchorov, Product Software Engineer (PHP). I build PHP products that have to keep working for years.',
  bare = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const ogImageURL = new URL(image, Astro.site).href;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={imageAlt} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />
  <meta name="twitter:image:alt" content={imageAlt} />

  <script defer data-domain="davorminchorov.com" src="https://plausible.io/js/plausible.file-downloads.js"></script>
</head>
<body>
  {!bare && <SiteNav />}

  <main>
    <slot />
  </main>

  {!bare && <SiteFooter />}

  <script>
    // Mobile nav toggle. The menu is an overlay on small screens, so it also
    // closes when a section link inside it is tapped.
    const toggle = document.getElementById('mobile-toggle');
    const nav = document.getElementById('nav-links');
    const OPEN_CLASSES = ['flex', 'flex-col', 'absolute', 'top-[60px]', 'left-0', 'right-0', 'bg-bg/[0.97]', 'backdrop-blur-md', 'p-5', 'border-b', 'border-border'];
    const setMenuOpen = (open: boolean) => {
      if (!nav || !toggle) return;
      nav.classList.toggle('hidden', !open);
      OPEN_CLASSES.forEach((cls) => nav.classList.toggle(cls, open));
      toggle.setAttribute('aria-expanded', String(open));
    };
    toggle?.addEventListener('click', () => {
      setMenuOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });
    nav?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setMenuOpen(false));
    });

    // Scroll animation observer
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.style.animationPlayState = 'running';
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.animate').forEach(el => {
      if (!el.closest('.hero')) {
        el.style.animationPlayState = 'paused';
      }
      observer.observe(el);
    });
  </script>
</body>
</html>
