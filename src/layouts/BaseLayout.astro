---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
}

const {
  title = 'Davor Minchorov | Product Software Engineer (PHP)',
  description = 'Product software engineer working in PHP. I help founders and product teams build APIs, design architecture, and modernise existing codebases, with an eye on what the product is for.',
  image = '/og-image.jpg',
  imageAlt = 'Davor Minchorov, Product Software Engineer (PHP). I build PHP products that have to keep working for years.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const ogImageURL = new URL(image, Astro.site).href;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={imageAlt} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />
  <meta name="twitter:image:alt" content={imageAlt} />

  <script defer data-domain="davorminchorov.com" src="https://plausible.io/js/plausible.js"></script>
</head>
<body>
  <!-- Nav -->
  <nav class="fixed top-0 left-0 right-0 z-50 bg-bg/85 backdrop-blur-md border-b border-border">
    <div class="max-w-[1080px] mx-auto px-7 flex items-center justify-between h-[60px]">
      <a href="/" class="font-display text-[17px] font-semibold text-text no-underline tracking-tight">
        Davor Minchorov
      </a>
      <button
        id="mobile-toggle"
        class="md:hidden bg-transparent border-none text-text cursor-pointer"
        aria-label="Menu"
        aria-controls="nav-links"
        aria-expanded="false"
      >
        <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M4 6h14M4 11h14M4 16h14" />
        </svg>
      </button>
      <div id="nav-links" class="hidden md:flex gap-9 items-center">
        <a href="/#about" class="text-sm font-medium text-text-muted no-underline hover:text-text transition-colors">About</a>
        <a href="/#services" class="text-sm font-medium text-text-muted no-underline hover:text-text transition-colors">Services</a>
        <a href="/#projects" class="text-sm font-medium text-text-muted no-underline hover:text-text transition-colors">Work</a>
        <a href="/#experience" class="text-sm font-medium text-text-muted no-underline hover:text-text transition-colors">Experience</a>
        <a href="/#skills" class="text-sm font-medium text-text-muted no-underline hover:text-text transition-colors">Skills</a>
        <a href="/#writing" class="text-sm font-medium text-text-muted no-underline hover:text-text transition-colors">Talks &amp; Writing</a>
        <a href="/#contact" class="text-sm font-medium text-text-muted no-underline hover:text-text transition-colors">Contact</a>
      </div>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <!-- Footer -->
  <footer class="border-t border-border py-9">
    <div class="max-w-[1080px] mx-auto px-7 flex justify-between items-center flex-wrap gap-4">
      <span class="text-[13px] text-text-dim">&copy; {new Date().getFullYear()} Davor Minchorov. All rights reserved.</span>
      <div class="flex flex-wrap gap-x-6 gap-y-2">
        <a href="https://x.com/davorminchorov" target="_blank" rel="noopener noreferrer" class="text-[13px] text-text-muted font-medium no-underline hover:text-text transition-colors">X / Twitter</a>
        <a href="https://bsky.app/profile/davorminchorov.com" target="_blank" rel="noopener noreferrer" class="text-[13px] text-text-muted font-medium no-underline hover:text-text transition-colors">Bluesky</a>
        <a href="https://linkedin.com/in/davorminchorov" target="_blank" rel="noopener noreferrer" class="text-[13px] text-text-muted font-medium no-underline hover:text-text transition-colors">LinkedIn</a>
        <a href="https://github.com/davorminchorov" target="_blank" rel="noopener noreferrer" class="text-[13px] text-text-muted font-medium no-underline hover:text-text transition-colors">GitHub</a>
        <a href="https://www.upwork.com/freelancers/~01284b0e7aa5b9f5a9" target="_blank" rel="noopener noreferrer" class="text-[13px] text-text-muted font-medium no-underline hover:text-text transition-colors">Upwork</a>
        <a href="https://www.toptal.com/developers/resume/davor-minchorov" target="_blank" rel="noopener noreferrer" class="text-[13px] text-text-muted font-medium no-underline hover:text-text transition-colors">Toptal</a>
      </div>
    </div>
  </footer>

  <script>
    // Mobile nav toggle. The menu is an overlay on small screens, so it also
    // closes when a section link inside it is tapped.
    const toggle = document.getElementById('mobile-toggle');
    const nav = document.getElementById('nav-links');
    const OPEN_CLASSES = ['flex', 'flex-col', 'absolute', 'top-[60px]', 'left-0', 'right-0', 'bg-bg/[0.97]', 'backdrop-blur-md', 'p-5', 'border-b', 'border-border'];
    const setMenuOpen = (open: boolean) => {
      if (!nav || !toggle) return;
      nav.classList.toggle('hidden', !open);
      OPEN_CLASSES.forEach((cls) => nav.classList.toggle(cls, open));
      toggle.setAttribute('aria-expanded', String(open));
    };
    toggle?.addEventListener('click', () => {
      setMenuOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });
    nav?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setMenuOpen(false));
    });

    // Scroll animation observer
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.style.animationPlayState = 'running';
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.animate').forEach(el => {
      if (!el.closest('.hero')) {
        el.style.animationPlayState = 'paused';
      }
      observer.observe(el);
    });
  </script>
</body>
</html>
